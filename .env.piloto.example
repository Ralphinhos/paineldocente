# Copie para .env.piloto. Preencha apenas no seu computador.
# Host/IP sem instancia: use a porta TCP da instancia informada pela TI.
MOODLE_DB_SERVER=SEU_SERVIDOR_SQL
MOODLE_DB_PORT=1433
MOODLE_DB_DATABASE=SEU_BANCO_MOODLE
MOODLE_DB_USER=SEU_USUARIO_DE_CONSULTA
MOODLE_DB_PASSWORD="PREENCHA_A_SENHA_LOCALMENTE"

# De 1 a 10 IDs das disciplinas no Moodle, separados por virgula.
# Exemplo de URL: /course/view.php?id=12345 -> ID 12345.
MOODLE_COURSE_IDS=

MOODLE_CATEGORY_ROOT=109
MOODLE_TEACHER_ROLE_ID=3
MOODLE_QUERY_WINDOW_DAYS=90
MOODLE_REQUEST_TIMEOUT_MS=90000

# Opcional: CA fornecida pela TI se o SQL Server usar certificado interno.
# Exemplo Windows: secrets/moodle-ca.pem
MOODLE_DB_CA_FILE=
