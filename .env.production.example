# Endereço HTTPS publicado pelo proxy institucional
APP_ORIGIN=https://paineldocente.unifenas.br

# Gere com: openssl rand -base64 48 | tr -d '\n'
JWT_SECRET=SUBSTITUIR_POR_SEGREDO_COM_48_BYTES
AUTH_PROXY_SHARED_SECRET=SUBSTITUIR_POR_SEGREDO_INTERNO_COM_48_BYTES
APP_DB_PASSWORD=SUBSTITUIR_POR_SEGREDO_ALFANUMERICO

# Identidade institucional OIDC
OIDC_ISSUER_URL=https://IDENTIDADE-INSTITUCIONAL/tenant
OIDC_CLIENT_ID=SUBSTITUIR
OIDC_CLIENT_SECRET=SUBSTITUIR
# Gere exatamente 32 bytes codificados em base64
OAUTH_COOKIE_SECRET=SUBSTITUIR

# Pessoas e escopos autorizados. Coordenação vê somente courseIds informados.
AUTH_USERS_JSON=[{"email":"ned@unifenas.br","name":"Equipe NED","role":"ned_admin","courseIds":[]},{"email":"coordenacao.exemplo@unifenas.br","name":"Coordenação Exemplo","role":"coordinator","courseIds":["1101"]},{"email":"gestao.exemplo@unifenas.br","name":"Alta Gestão","role":"executive","courseIds":[]}]

# Moodle SQL Server: usuário dedicado com SELECT apenas
MOODLE_DB_SERVER=sql-moodle.interno.unifenas.br
MOODLE_DB_PORT=1433
MOODLE_DB_DATABASE=moodle
MOODLE_DB_USER=painel_docente_ro
MOODLE_DB_PASSWORD=SUBSTITUIR
MOODLE_CATEGORY_ROOT=109
MOODLE_TEACHER_ROLE_ID=3
MOODLE_QUERY_WINDOW_DAYS=400
MOODLE_REQUEST_TIMEOUT_MS=90000

# Só altere para true após executar docs/VALIDACAO_REGRAS.md
RULES_APPROVED=false
SNAPSHOT_INTERVAL_MINUTES=1440

# Só altere para true após homologar dados, destinatários e SMTP
EMAIL_SEND_ENABLED=false
REPORT_RECIPIENTS_JSON=[]
SMTP_HOST=smtp.interno.unifenas.br
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ned@unifenas.br
